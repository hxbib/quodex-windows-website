{
  "name": "quodex-windows-website",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive Windows 11 landing for Quodex for Windows — lives at quodex.app/windows.",
  "license": "MIT",
  "homepage": "https://quodex.app/windows",
  "repository": {
    "type": "git",
    "url": "https://github.com/hxbib/quodex-windows-website.git"
  },
  "scripts": {
    "dev": "QUODEX_BASE=/ vite --config vite.landing.config.ts --host 0.0.0.0 --port 8080",
    "build": "QUODEX_BASE=/windows/ vite build --config vite.landing.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/quodex/transitions.test.ts src/lib/quodex/demo.test.ts src/lib/site.test.ts src/lib/openai/web-guard.test.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0"
  }
}
